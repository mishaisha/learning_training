\f2\fs32 \cf2 \strokec2 \
\pard\pardeftab720\partightenfactor0
\cf8 \strokec8 \
\pard\pardeftab720\partightenfactor0

\f0\fs38\fsmilli19200 \cf2 \cb12 \strokec2 Machine learning is a subset of artificial intelligence that involves training algorithms to learn from data, while artificial intelligence encompasses a wider range of technologies aimed at simulating human intelligence\cb1 \
\pard\pardeftab720\partightenfactor0

\f2\fs32 \cf5 \strokec5 \
\pard\pardeftab720\partightenfactor0

