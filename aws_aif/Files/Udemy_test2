\pard\pardeftab720\partightenfactor0

\f2\fs32 \cf2 \strokec2 \
\pard\pardeftab720\partightenfactor0
\cf8 \strokec8 \
\pard\pardeftab720\partightenfactor0

\f0\fs38\fsmilli19200 \cf2 \cb12 \strokec2 Validation sets are optional\cb1 \
