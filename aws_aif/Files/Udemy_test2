\pard\pardeftab720\partightenfactor0

\f2\fs32 \cf5 \strokec5 \
\pard\pardeftab720\partightenfactor0

\f0\fs38\fsmilli19200 \cf6 \cb7 \strokec6 Data access control is responsible for data encryption, while data integrity focuses on auditing and logging user activities\cb1 \
\pard\pardeftab720\partightenfactor0

\f2\fs32 \cf5 \strokec5 \
\pard\pardeftab720\partightenfactor0

\f0\fs38\fsmilli19200 \cf6 \cb7 \strokec6 Data access control and data integrity are both concerned with encrypting data at rest and in transit\cb1 \
\pard\pardeftab720\partightenfactor0

\f2\fs32 \cf2 \strokec2 \
\pard\pardeftab720\partightenfactor0
\cf8 \strokec8 \
\pard\pardeftab720\partightenfactor0

\f0\fs38\fsmilli19200 \cf2 \cb12 \strokec2 Data access control involves authentication and authorization of users, whereas data integrity ensures the data is accurate, consistent, and unaltered\cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb7 Overall explanation
\f1 \cb1 \
\pard\pardeftab720\partightenfactor0
