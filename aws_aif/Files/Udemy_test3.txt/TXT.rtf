\cf10 \strokec10 \
\pard\pardeftab720\partightenfactor0

\f0\fs38\fsmilli19200 \cf2 \cb11 \strokec2 Requests with large payload sizes up to 1GB and long processing times\cb1 \
\pard\pardeftab720\partightenfactor0

\f2\fs32 \cf5 \strokec5 \
\pard\pardeftab720\partightenfactor0

\f0\fs38\fsmilli19200 \cf6 \cb7 \strokec6 To get predictions for an entire dataset\cb1 \
\pard\pardeftab720\partightenfactor0

\f2\fs32 \cf5 \strokec5 \
\pard\pardeftab720\partightenfactor0

\f0\fs38\fsmilli19200 \cf6 \cb7 \strokec6 For persistent, real-time endpoints that make one prediction at a time\cb1 \
